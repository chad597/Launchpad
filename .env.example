# Demo mode runs the app entirely on in-memory seed data. Set to "false" once
# the Launchpad Supabase project exists and the vars below are filled in.
DEMO_MODE=true

# Supabase (create under the Launchpad org account, then apply supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar: program-owned account (e.g. mentorship@launchpad...).
# Service credentials for creating meeting events. See README.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Transactional email (Resend or similar)
RESEND_API_KEY=
EMAIL_FROM="Launchpad Mentorship <mentorship@example.com>"
